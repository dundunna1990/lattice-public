[Unit]
Description=Lattice Dedicated SFTP-Only File Service
After=network.target
ConditionPathExists=/etc/lattice/file-ssh/sshd_config
ConditionPathExists=/srv/lattice-file-root/Home

[Service]
Type=simple
User=root
Group=root

ExecStartPre=/usr/bin/install -d -o root -g root -m 0755 /run/sshd
ExecStartPre=/opt/lattice/venv/bin/python -m lattice.core.runtime_environment
ExecStartPre=/opt/lattice/venv/bin/python -m lattice.file_access.home_export
ExecStartPre=/usr/sbin/sshd -t -f /etc/lattice/file-ssh/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/lattice/file-ssh/sshd_config
ExecStartPost=/opt/lattice/venv/bin/python -m lattice.core.release_convergence

Restart=on-failure
RestartSec=3s
TimeoutStartSec=30
TimeoutStopSec=20
KillMode=mixed

RuntimeDirectory=lattice-file-sshd
RuntimeDirectoryMode=0755
BindReadOnlyPaths=/etc/lattice/file-ssh/authorized_keys:/run/lattice-file-sshd/authorized_keys

PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
