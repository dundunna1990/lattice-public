[Unit]
Description=Lattice Dedicated Trusted Admin Shell SSH Service
After=network.target
ConditionPathExists=/etc/lattice/shell-ssh/sshd_config

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/opt/lattice/venv/bin/python -m lattice.core.runtime_environment
ExecStartPre=/usr/sbin/sshd -t -f /etc/lattice/shell-ssh/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/lattice/shell-ssh/sshd_config
ExecStartPost=/opt/lattice/venv/bin/python -m lattice.core.release_convergence
ExecStopPost=/opt/lattice/venv/bin/python -m lattice.shell_access.session_cleanup
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30
TimeoutStopSec=20
# A restart must terminate every authenticated session, not only the listener.
# Otherwise an old multiplexed SSH session can outlive PrivateTmp cleanup.
KillMode=control-group
RuntimeDirectory=lattice-shell-sshd
RuntimeDirectoryMode=0755
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
